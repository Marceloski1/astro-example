---
import Layout from '../../layouts/Layout.astro';
import DataStream from '../../components/DataStream.astro';
---

<Layout title="Data Stream Background | Astro Books">
	<main class="min-h-screen bg-black overflow-hidden flex flex-col items-center justify-center relative">
		<!-- Background Service -->
		<div class="fixed inset-0 z-0">
			<DataStream />
		</div>

		<!-- UI Layer -->
		<div class="relative z-10 text-center max-w-2xl px-8">
			<div class="inline-block px-4 py-1 border border-blue-500/30 rounded-full mb-8">
				<span class="text-blue-500 font-mono text-[0.5rem] uppercase tracking-[0.4em]">Core.Network.Flux</span>
			</div>
			<h1 class="text-8xl font-black text-white italic tracking-tighter mb-6 bg-clip-text text-transparent bg-gradient-to-b from-white to-white/20">
				STREAM
			</h1>
			<p class="text-white/40 text-xs font-mono uppercase tracking-widest leading-loose">
				Visualizing the constant flow of information between database nodes. Every point represents a data packet transition.
			</p>
			
			<div class="mt-16 grid grid-cols-3 gap-8 text-[0.4rem] font-mono text-white/20 uppercase tracking-[0.3em]">
				<div class="flex flex-col gap-2">
					<span class="text-white">Active Nodes</span>
					<span>1,240,432</span>
				</div>
				<div class="flex flex-col gap-2">
					<span class="text-white">Throughput</span>
					<span>45.2 GB/s</span>
				</div>
				<div class="flex flex-col gap-2">
					<span class="text-white">Uptime</span>
					<span>99.998%</span>
				</div>
			</div>
		</div>

		<!-- Subtle Vignette -->
		<div class="fixed inset-0 pointer-events-none bg-radial-gradient from-transparent via-transparent to-black/80"></div>
	</main>
</Layout>
