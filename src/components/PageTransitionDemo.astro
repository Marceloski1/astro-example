---
---

<div class="transition-container py-20 flex flex-col items-center gap-12">
    <div class="text-center max-w-lg mb-12">
        <h2 class="text-white font-mono text-[0.6rem] uppercase tracking-[0.8em] mb-4">View.Transitions.Pro</h2>
        <p class="text-white/30 text-xs font-mono uppercase tracking-widest leading-loose">
            Experience seamless navigation with custom light-sweep shaders and layout interpolation.
        </p>
    </div>

    <div class="grid grid-cols-2 gap-8 w-full max-w-4xl px-8">
        <!-- Demo Link 1 -->
        <a href="/portal" class="transition-card group relative p-12 bg-gray-900 border border-white/5 rounded-2xl overflow-hidden hover:border-blue-500/30 transition-all">
            <div class="relative z-10">
                <span class="text-blue-500 font-mono text-[0.5rem] tracking-widest block mb-1">01</span>
                <h3 class="text-white font-black text-2xl italic">PORTAL</h3>
            </div>
            <!-- Light Sweep Effect -->
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out"></div>
        </a>

        <!-- Demo Link 2 -->
        <a href="/hiper-spacial" class="transition-card group relative p-12 bg-gray-900 border border-white/5 rounded-2xl overflow-hidden hover:border-purple-500/30 transition-all">
            <div class="relative z-10">
                <span class="text-purple-500 font-mono text-[0.5rem] tracking-widest block mb-1">02</span>
                <h3 class="text-white font-black text-2xl italic">TUNNEL</h3>
            </div>
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-1000 ease-in-out"></div>
        </a>
    </div>

    <!-- Transition Slider Controls (Visual Only) -->
    <div class="mt-20 w-full max-w-xl h-1 bg-white/5 rounded-full relative overflow-hidden">
        <div class="absolute inset-0 bg-blue-500 w-1/4 animate-ping opacity-20"></div>
        <div class="absolute inset-0 bg-blue-500 w-1/4 translate-x-1/2"></div>
    </div>
</div>

<style>
    .transition-card {
        box-shadow: 0 10px 30px -10px rgba(0,0,0,0.5);
    }
    .transition-card:hover {
        box-shadow: 0 20px 40px -15px rgba(59, 130, 246, 0.2);
    }
</style>
