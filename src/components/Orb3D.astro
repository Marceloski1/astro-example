<div id="orb-canvas-container" class="w-full h-screen relative bg-[#020202] overflow-hidden cursor-crosshair">
    <div class="absolute inset-0 z-10 pointer-events-none flex flex-col justify-center items-center text-center p-8">
        <h2 id="orb-status" class="text-blue-500 font-mono text-xs tracking-[0.5em] uppercase mb-4 opacity-50">Nucleus Static</h2>
        <h1 class="text-7xl font-light text-white tracking-widest uppercase mb-2">The Knowledge Orb</h1>
        <p class="text-white/20 text-sm font-mono tracking-widest max-w-lg leading-loose">
            Holographic condensation of archived data nodes. Interact with the core to destabilize the field.
        </p>
    </div>
    
    <div id="orb-ui" class="absolute bottom-12 left-1/2 -translate-x-1/2 z-10 flex gap-8 items-center text-white/50 text-[0.6rem] tracking-[0.3em] uppercase">
        <div class="flex items-center gap-2">
            <div class="w-1.5 h-1.5 rounded-full bg-blue-500"></div>
            <span>Move mouse to distort</span>
        </div>
        <div class="w-12 h-px bg-white/10"></div>
        <div class="flex items-center gap-2">
            <div class="w-1.5 h-1.5 rounded-full bg-red-400"></div>
            <span>Click to expand</span>
        </div>
    </div>
</div>

<script>
    import * as THREE from 'three';
    import * as TWEEN from 'three/examples/jsm/libs/tween.module.js';

    let scene, camera, renderer, clock;
    let orbMesh, wireframeMesh, particles;
    let mouse = new THREE.Vector2();
    let target = new THREE.Vector2();
    const container = document.getElementById('orb-canvas-container');

    function init() {
        if (!container) return;

        scene = new THREE.Scene();
        camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
        camera.position.z = 10;

        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(container.clientWidth, container.clientHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        container.appendChild(renderer.domElement);

        clock = new THREE.Clock();

        // Custom Shader Material for Liquid Effect
        const orbGeo = new THREE.IcosahedronGeometry(2, 64);
        const orbMat = new THREE.MeshStandardMaterial({
            color: 0x3b82f6,
            wireframe: false,
            transparent: true,
            opacity: 0.1,
            metalness: 0.9,
            roughness: 0.1,
            emissive: 0x0088ff,
            emissiveIntensity: 0.5
        });

        orbMesh = new THREE.Mesh(orbGeo, orbMat);
        scene.add(orbMesh);

        // Core Wireframe
        const wireMat = new THREE.MeshBasicMaterial({ 
            color: 0xffffff, 
            wireframe: true, 
            transparent: true, 
            opacity: 0.05 
        });
        wireframeMesh = new THREE.Mesh(orbGeo, wireMat);
        wireframeMesh.scale.setScalar(1.05);
        scene.add(wireframeMesh);

        // Lights
        const p1 = new THREE.PointLight(0xff00ff, 20);
        p1.position.set(5, 5, 5);
        scene.add(p1);

        const p2 = new THREE.PointLight(0x00ffff, 20);
        p2.position.set(-5, -5, 5);
        scene.add(p2);

        // Internal Particles
        const partGeo = new THREE.BufferGeometry();
        const partCount = 2000;
        const posArray = new Float32Array(partCount * 3);
        for(let i=0; i<partCount*3; i++) posArray[i] = (Math.random() - 0.5) * 4;
        partGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
        const partMat = new THREE.PointsMaterial({ size: 0.01, color: 0xffffff, transparent: true, opacity: 0.5 });
        particles = new THREE.Points(partGeo, partMat);
        scene.add(particles);

        // Events
        window.addEventListener('resize', onResize);
        container.addEventListener('mousemove', onMouseMove);
        container.addEventListener('mousedown', onExpand);

        animate();
    }

    function onMouseMove(e) {
        const rect = container.getBoundingClientRect();
        target.x = ((e.clientX - rect.left) / container.clientWidth) * 2 - 1;
        target.y = -((e.clientY - rect.top) / container.clientHeight) * 2 + 1;
    }

    function onExpand() {
        new TWEEN.Tween(orbMesh.scale)
            .to({ x: 2, y: 2, z: 2 }, 500)
            .easing(TWEEN.Easing.Elastic.Out)
            .start()
            .onComplete(() => {
                new TWEEN.Tween(orbMesh.scale).to({ x: 1, y: 1, z: 1 }, 1000).easing(TWEEN.Easing.Bounce.Out).start();
            });

        document.getElementById('orb-status').textContent = "Field Destabilized";
        document.getElementById('orb-status').classList.remove('text-blue-500');
        document.getElementById('orb-status').classList.add('text-red-400');
        
        setTimeout(() => {
            document.getElementById('orb-status').textContent = "Nucleus Static";
            document.getElementById('orb-status').classList.add('text-blue-500');
            document.getElementById('orb-status').classList.remove('text-red-400');
        }, 2000);
    }

    function onResize() {
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
    }

    function animate() {
        requestAnimationFrame(animate);
        TWEEN.update();
        const t = clock.getElapsedTime();

        mouse.x += (target.x - mouse.x) * 0.1;
        mouse.y += (target.y - mouse.y) * 0.1;

        // Liquify Vertex-like Animation
        const positionAttribute = orbMesh.geometry.getAttribute('position');
        const vertex = new THREE.Vector3();
        for (let i = 0; i < positionAttribute.count; i++) {
            vertex.fromBufferAttribute(positionAttribute, i);
            const noise = Math.sin(vertex.x * 2 + t) * Math.cos(vertex.y * 2 + t) * 0.1;
            const dist = vertex.distanceTo(new THREE.Vector3(mouse.x * 2, mouse.y * 2, 0));
            const mouseDeform = Math.max(0, 1 - dist * 0.5) * 0.5;
            
            vertex.normalize().multiplyScalar(2 + noise + mouseDeform);
            positionAttribute.setXYZ(i, vertex.x, vertex.y, vertex.z);
        }
        positionAttribute.needsUpdate = true;

        orbMesh.rotation.y += 0.005;
        wireframeMesh.rotation.y -= 0.003;
        particles.rotation.z += 0.001;

        renderer.render(scene, camera);
    }

    document.addEventListener('astro:page-load', () => {
        if (!window.orbActive) {
            init();
            window.orbActive = true;
        }
    });

    if (!window.orbActive) {
        init();
        window.orbActive = true;
    }
</script>

<style>
    #orb-canvas-container canvas {
        mask-image: radial-gradient(circle at center, black 60%, transparent 100%);
    }
</style>
