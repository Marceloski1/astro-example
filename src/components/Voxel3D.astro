<div id="voxel-stage" class="w-full h-screen relative bg-[#050505] overflow-hidden">
    <!-- UI Overlay -->
    <div class="absolute inset-0 z-10 pointer-events-none p-12 flex flex-col justify-between">
        <div class="flex justify-between items-start">
            <span class="text-green-500 font-mono text-[0.6rem] uppercase tracking-[0.4em]">Grid.Matrix.Level_04</span>
            <div class="flex flex-col items-end">
                <span id="voxel-count" class="text-white/40 font-mono text-[0.6rem]">CELLS: 10,000</span>
                <div class="w-24 h-[1px] bg-green-500/20 mt-1"></div>
            </div>
        </div>

        <div class="max-w-lg">
            <h1 class="text-5xl font-bold text-white tracking-widest uppercase mb-2">VOXEL WORLD</h1>
            <p class="text-green-500/40 text-[0.5rem] font-mono tracking-[0.2em] leading-relaxed max-w-xs">
                Procedural cube terrain with real-time vertex displacement. Sinusoidal wave function active.
            </p>
        </div>
    </div>

    <div class="absolute inset-0" id="voxel-canvas-container"></div>
</div>

<script>
    import * as THREE from 'three';

    let scene, camera, renderer, clock;
    let instancedMesh;
    let pointLights = [];
    const count = 50; 
    const total = count * count;
    const dummy = new THREE.Object3D();

    function init() {
        const container = document.getElementById('voxel-canvas-container');
        if (!container || container.children.length > 0) return;

        scene = new THREE.Scene();
        scene.background = new THREE.Color(0x020202);
        
        camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 1, 1000);
        camera.position.set(45, 45, 45);
        camera.lookAt(0, 0, 0);

        renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        container.appendChild(renderer.domElement);

        clock = new THREE.Clock();

        const geo = new THREE.BoxGeometry(0.9, 0.9, 0.9);
        const mat = new THREE.MeshStandardMaterial({ 
            roughness: 0.15, 
            metalness: 0.9,
            vertexColors: true 
        });
        
        instancedMesh = new THREE.InstancedMesh(geo, mat, total);
        scene.add(instancedMesh);

        // Advanced Multi-Light System
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.2);
        scene.add(ambientLight);

        // 8 Moving Point Lights for "More Streaks"
        const lightColors = [0x00ffff, 0xff00ff, 0x00ff00, 0xffff00, 0x0000ff, 0xff0000, 0xffffff, 0x3b82f6];
        for (let i = 0; i < 8; i++) {
            const pLight = new THREE.PointLight(lightColors[i], 40, 60);
            scene.add(pLight);
            pointLights.push({
                light: pLight,
                angle: (i / 8) * Math.PI * 2,
                speed: 0.2 + Math.random() * 0.5,
                radius: 15 + Math.random() * 20
            });
        }

        const mainLight = new THREE.DirectionalLight(0xffffff, 0.8);
        mainLight.position.set(50, 100, 50);
        scene.add(mainLight);

        window.addEventListener('resize', onResize);
        animate();
    }

    function onResize() {
        if (!renderer || !camera) return;
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    }

    function animate() {
        if (!renderer || !scene) return;
        requestAnimationFrame(animate);
        
        const t = clock.getElapsedTime();

        // Animate Point Lights
        pointLights.forEach((lp, i) => {
            lp.light.position.x = Math.cos(t * lp.speed + lp.angle) * lp.radius;
            lp.light.position.z = Math.sin(t * lp.speed + lp.angle) * lp.radius;
            lp.light.position.y = 10 + Math.sin(t + i) * 5;
        });

        let i = 0;
        const color = new THREE.Color();
        const scannerPos = (t * 5) % 80 - 40; // Scanning line position

        for(let x=0; x<count; x++) {
            for(let z=0; z<count; z++) {
                const posX = x - count/2;
                const posZ = z - count/2;
                
                // Sinusoidal wave
                const dist = Math.sqrt(posX * posX + posZ * posZ);
                const y = Math.sin(dist * 0.2 - t * 1.5) * 2.5;
                
                dummy.position.set(posX, y, posZ);
                
                // Dynamic color & "Rayas de iluminación" (Scanner effect)
                const isScanner = Math.abs(posX - scannerPos) < 1.0;
                
                if (isScanner) {
                    color.setHex(0xffffff);
                    dummy.scale.set(1.1, 1.2, 1.1);
                } else {
                    const hue = (0.6 + Math.sin(t * 0.1 + dist * 0.05) * 0.2);
                    color.setHSL(hue, 0.8, 0.3 + y * 0.05);
                    dummy.scale.set(1, 1, 1);
                }
                
                instancedMesh.setColorAt(i, color);
                dummy.updateMatrix();
                instancedMesh.setMatrixAt(i++, dummy.matrix);
            }
        }
        instancedMesh.instanceMatrix.needsUpdate = true;
        if (instancedMesh.instanceColor) instancedMesh.instanceColor.needsUpdate = true;

        scene.rotation.y += 0.001;

        renderer.render(scene, camera);
    }

    document.addEventListener('astro:page-load', init);
    init();
</script>
