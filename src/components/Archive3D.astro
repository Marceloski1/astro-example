---
---

<div id="archive-stage" class="w-full h-screen relative bg-[#0a0a0a] overflow-hidden">
    <!-- UI Overlay (Side Scifi) -->
    <div class="absolute inset-y-0 left-0 w-24 border-r border-white/5 bg-black/50 z-10 flex flex-col items-center py-12 gap-8 pointer-events-none">
        <div class="w-8 h-8 rounded-full border border-white/10 flex items-center justify-center animate-spin">
            <div class="w-1 h-1 bg-blue-500 rounded-full"></div>
        </div>
        <div class="h-32 w-[1px] bg-gradient-to-b from-transparent via-blue-500/50 to-transparent"></div>
        <span class="rotate-90 text-[0.4rem] font-mono text-white/20 uppercase tracking-[0.5em] whitespace-nowrap">Catalog.Index.001</span>
    </div>

    <div class="absolute inset-0 z-10 pointer-events-none p-24 flex flex-col justify-end">
        <div class="max-w-xl">
             <h1 class="text-4xl font-bold text-white mb-2 italic">INFINITE ARCHIVE</h1>
             <p class="text-white/30 text-[0.5rem] font-mono tracking-widest uppercase mb-8">
                 Cylindrical book distribution. Scroll to rotate the shelf.
             </p>
        </div>
    </div>

    <div class="absolute inset-0" id="archive-canvas-container"></div>
</div>

<script>
    import * as THREE from 'three';

    let scene, camera, renderer, clock;
    let archiveGroup;
    let rotationTarget = 0;
    
    const container = document.getElementById('archive-canvas-container');

    function init() {
        if (!container) return;

        scene = new THREE.Scene();
        scene.fog = new THREE.Fog(0x0a0a0a, 20, 50);

        camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.set(0, 0, 15);

        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        container.appendChild(renderer.domElement);

        clock = new THREE.Clock();

        archiveGroup = new THREE.Group();
        scene.add(archiveGroup);

        // Create Book Pillars
        const radius = 10;
        const count = 36;
        const height = 10;
        
        for (let j = -3; j <= 3; j++) {
            for (let i = 0; i < count; i++) {
                const angle = (i / count) * Math.PI * 2;
                const bookGeo = new THREE.BoxGeometry(1.2, 1.8, 0.2);
                const bookMat = new THREE.MeshPhongMaterial({ 
                    color: new THREE.Color().setHSL(Math.random(), 0.5, 0.2),
                    shininess: 50
                });
                const book = new THREE.Mesh(bookGeo, bookMat);
                
                book.position.set(
                    Math.cos(angle) * radius,
                    j * 2.5,
                    Math.sin(angle) * radius
                );
                book.lookAt(0, j * 2.5, 0);
                archiveGroup.add(book);
            }
        }

        const ambient = new THREE.AmbientLight(0x404040);
        scene.add(ambient);
        const point = new THREE.PointLight(0x3b82f6, 100, 50);
        point.position.set(0, 0, 5);
        scene.add(point);

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onResize);
        animate();
    }

    function onScroll() {
        const h = document.documentElement.scrollHeight - window.innerHeight;
        rotationTarget = (window.scrollY / h) * Math.PI * 4;
    }

    function onResize() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    }

    function animate() {
        requestAnimationFrame(animate);
        const t = clock.getElapsedTime();

        archiveGroup.rotation.y += (rotationTarget - archiveGroup.rotation.y) * 0.05;
        archiveGroup.position.y = Math.sin(t * 0.5) * 0.5;

        renderer.render(scene, camera);
    }

    document.addEventListener('astro:page-load', () => {
        const container = document.getElementById('archive-canvas-container');
        if (container && container.children.length === 0) init();
    });

    init();
</script>
