---
---

<div id="library-vault" class="w-full h-[800px] relative rounded-[3rem] overflow-hidden bg-black shadow-[inset_0_0_100px_rgba(0,0,0,1)] border border-white/5 group cursor-grab active:cursor-grabbing">
    <!-- Scifi HUD Canvas Overlay -->
    <div class="hud-overlay absolute inset-0 pointer-events-none z-10 border-[40px] border-transparent p-12 flex flex-col justify-between">
        <div class="hud-top flex justify-between items-start opacity-40">
            <div class="flex flex-col gap-1">
                <div class="h-[2px] w-20 bg-blue-500 shadow-[0_0_10px_#3b82f6]"></div>
                <span class="text-[0.5rem] font-mono text-blue-500 uppercase tracking-[0.5em]">System.Astro.Core</span>
            </div>
            <div class="text-right text-white/20 font-mono text-[0.5rem] tracking-widest uppercase">
                Sector_07 // Library_Vault<br/>
                Coordinates: 43.12 / 88.09
            </div>
        </div>

        <div id="book-data-panel" class="opacity-0 transition-all duration-700 translate-y-8">
            <div class="flex items-end gap-6 mb-4">
                <span id="book-title" class="text-8xl font-black text-white italic tracking-tighter leading-none"></span>
                <span id="book-index" class="text-blue-500 font-mono text-lg border-b border-blue-500 pb-1 mb-2"></span>
            </div>
            <div class="grid grid-cols-2 gap-12 max-w-2xl border-l border-white/10 pl-8 ml-2">
                <div>
                    <span class="text-[0.6rem] text-white/30 uppercase tracking-[0.3em] block mb-2">Author.Identity</span>
                    <span id="book-author" class="text-white text-xl font-light tracking-wide"></span>
                    <div id="author-line" class="h-px w-0 bg-blue-500/50 mt-2 transition-all duration-1000"></div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <span class="text-[0.6rem] text-white/30 uppercase tracking-[0.3em] block mb-2">Rel.Era</span>
                        <span id="book-year" class="text-blue-400 font-mono"></span>
                    </div>
                    <div>
                        <span class="text-[0.6rem] text-white/30 uppercase tracking-[0.3em] block mb-2">Cls.Tag</span>
                        <span id="book-genre" class="text-white font-mono text-xs border border-white/20 px-2 py-0.5 rounded"></span>
                    </div>
                </div>
            </div>
        </div>

        <div id="interaction-hint" class="hud-bottom flex justify-between items-end">
            <div class="flex flex-col gap-4">
                <div class="flex items-center gap-3 text-white/30 text-[0.6rem] tracking-[0.4em] uppercase">
                    <div class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></div>
                    <span>Vault.Kinetic.Active</span>
                </div>
                <p class="text-white/10 text-[0.5rem] uppercase tracking-widest leading-loose">
                    Interactive Grid v9.1.0<br/>
                    Drag to rotate field / Select to extract
                </p>
            </div>
            <div class="flex items-center gap-6">
                 <div id="scroll-info" class="text-right opacity-40">
                    <span class="text-[0.5rem] text-white uppercase tracking-widest block">Rotation Offset</span>
                    <div class="h-1 w-32 bg-white/10 mt-1 rounded-full overflow-hidden">
                        <div id="rotation-progress" class="h-full bg-blue-500 w-0"></div>
                    </div>
                 </div>
            </div>
        </div>
    </div>

    <!-- Background Cinematic Glow -->
    <div class="absolute inset-x-0 top-0 h-1/2 bg-gradient-to-b from-blue-900/10 to-transparent pointer-events-none"></div>
</div>

<script>
    import * as THREE from 'three';
    import * as TWEEN from 'three/examples/jsm/libs/tween.module.js';

    const booksData = [
        { id: 'SC-01', title: 'CLEAN', author: 'Robert C. Martin', color: 0x00ffff, year: 2008, genre: 'SOFTWARE' },
        { id: 'DV-02', title: 'PRAGMATIC', author: 'Andrew Hunt', color: 0xff0055, year: 1999, genre: 'DEVELOPMENT' },
        { id: 'MG-03', title: 'MYTHICAL', author: 'Fred Brooks', color: 0x00ffaa, year: 1975, genre: 'MANAGEMENT' },
        { id: 'AR-04', title: 'PATTERNS', author: 'Gang of Four', color: 0xffaa00, year: 1994, genre: 'ARCHITECTURE' },
        { id: 'SC-05', title: 'REFACTOR', author: 'Martin Fowler', color: 0xaa00ff, year: 1999, genre: 'SOFTWARE' },
        { id: 'DV-06', title: 'COMPLETE', author: 'Steve McConnell', color: 0x55ff00, year: 1993, genre: 'DEVELOPMENT' },
        { id: 'PR-07', title: 'ELOQUENT', author: 'Marijn Haverbeke', color: 0x00aaff, year: 2011, genre: 'PROGRAMMING' },
        { id: 'JS-08', title: 'YDKJS', author: 'Kyle Simpson', color: 0xffee00, year: 2014, genre: 'JAVASCRIPT' }
    ];

    let scene, camera, renderer, mouse, raycaster, clock;
    let books = [];
    let selectedGroup = null;
    let particles, gridHelper, vaultRing, booksContainer;

    // Kinetic State
    let isDragging = false;
    let previousTouchX = 0;
    let targetRotation = 0;
    let currentRotation = 0;
    let rotationVelocity = 0;
    const friction = 0.95;

    const container = document.getElementById('library-vault');

    function init() {
        if (!container) return;

        scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x000000, 0.08);

        camera = new THREE.PerspectiveCamera(30, container.clientWidth / container.clientHeight, 0.1, 1000);
        camera.position.set(0, 15, 25);
        camera.lookAt(0, 0, 0);

        renderer = new THREE.WebGLRenderer({ antialias: true, stencil: false });
        renderer.setSize(container.clientWidth, container.clientHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.shadowMap.enabled = true;
        container.appendChild(renderer.domElement);

        mouse = new THREE.Vector2();
        raycaster = new THREE.Raycaster();
        clock = new THREE.Clock();

        // High Intensity Scifi Lights
        const amb = new THREE.AmbientLight(0xffffff, 0.05);
        scene.add(amb);

        const topLight = new THREE.DirectionalLight(0x0088ff, 2);
        topLight.position.set(5, 10, 5);
        scene.add(topLight);

        // Vault Halo
        const ringGeo = new THREE.TorusGeometry(8, 0.01, 16, 100);
        const ringMat = new THREE.MeshBasicMaterial({ color: 0x00ffff, transparent: true, opacity: 0.1 });
        vaultRing = new THREE.Mesh(ringGeo, ringMat);
        vaultRing.rotation.x = Math.PI / 2;
        scene.add(vaultRing);

        // Animated Scanning Grid
        gridHelper = new THREE.GridHelper(30, 60, 0x111111, 0x050505);
        gridHelper.position.y = -2;
        scene.add(gridHelper);

        // Data Particles
        const partGeo = new THREE.BufferGeometry();
        const partCount = 1000;
        const posArray = new Float32Array(partCount * 3);
        const colArray = new Float32Array(partCount * 3);
        for(let i=0; i<partCount*3; i++) {
            posArray[i] = (Math.random() - 0.5) * 20;
            colArray[i] = Math.random();
        }
        partGeo.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
        partGeo.setAttribute('color', new THREE.BufferAttribute(colArray, 3));
        const partMat = new THREE.PointsMaterial({ size: 0.02, vertexColors: true, transparent: true, opacity: 0.3 });
        particles = new THREE.Points(partGeo, partMat);
        scene.add(particles);

        // Books Container Group
        booksContainer = new THREE.Group();
        scene.add(booksContainer);

        // Books in a Hexagonal Formation
        const bW = 0.4;
        const bH = 1.6;
        const bD = 1.1;
        
        booksData.forEach((data, i) => {
            const group = new THREE.Group();
            
            // Neon Frame Material
            const mat = new THREE.MeshStandardMaterial({ 
                color: 0x0a0a0a,
                roughness: 0.1,
                metalness: 1.0,
                emissive: data.color,
                emissiveIntensity: 0.2
            });
            
            const bookMesh = new THREE.Mesh(new THREE.BoxGeometry(bW, bH, bD), mat);
            bookMesh.castShadow = true;
            group.add(bookMesh);

            // Data Strip
            const stripGeo = new THREE.PlaneGeometry(0.3, 1.4);
            const stripMat = new THREE.MeshBasicMaterial({ color: data.color, transparent: true, opacity: 0.8 });
            const strip = new THREE.Mesh(stripGeo, stripMat);
            strip.position.z = 0.551;
            bookMesh.add(strip);

            // Inner Glow Point
            const pLight = new THREE.PointLight(data.color, 0, 5);
            group.add(pLight);

            const angle = (i / booksData.length) * Math.PI * 2;
            const radius = 6;
            group.position.set(Math.cos(angle) * radius, 0, Math.sin(angle) * radius);
            group.lookAt(0, 0, 0);

            group.userData = {
                data: data,
                home: group.position.clone(),
                homeRot: group.rotation.clone(),
                light: pLight,
                active: false,
                idx: i
            };

            books.push(group);
            booksContainer.add(group);
        });

        // Events
        window.addEventListener('resize', onWindowResize);
        container.addEventListener('mousedown', onMouseDown);
        window.addEventListener('mousemove', onMouseMove);
        window.addEventListener('mouseup', onMouseUp);
        
        container.addEventListener('touchstart', (e) => onMouseDown(e.touches[0]));
        window.addEventListener('touchmove', (e) => onMouseMove(e.touches[0]));
        window.addEventListener('touchend', (e) => onMouseUp());

        // Intro Camera Animation
        new TWEEN.Tween(camera.position)
            .to({ x: 0, y: 1, z: 12 }, 3000)
            .easing(TWEEN.Easing.Cubic.InOut)
            .start();

        animate();
    }

    function onMouseDown(e) {
        const rect = container.getBoundingClientRect();
        mouse.x = ((e.clientX - rect.left) / container.clientWidth) * 2 - 1;
        mouse.y = -((e.clientY - rect.top) / container.clientHeight) * 2 + 1;

        isDragging = true;
        previousTouchX = e.clientX;
        rotationVelocity = 0;

        // Si hay una selección activa y hacemos click fuera o arrastramos, reseteamos
        if (selectedGroup) {
            raycaster.setFromCamera(mouse, camera);
            const hits = raycaster.intersectObjects(booksContainer.children, true);
            if (hits.length === 0) resetVault();
        }
    }

    function onMouseMove(e) {
        if (!isDragging || selectedGroup) {
            updateMousePos(e);
            return;
        }

        const deltaX = e.clientX - previousTouchX;
        rotationVelocity = deltaX * 0.005;
        targetRotation += rotationVelocity;
        previousTouchX = e.clientX;
    }

    function onMouseUp() {
        if (!isDragging) return;
        isDragging = false;

        // Si el "drag" fue mínimo, lo tratamos como click
        if (Math.abs(rotationVelocity) < 0.001) {
            handleSelection();
        }
    }

    function updateMousePos(e) {
        const rect = container.getBoundingClientRect();
        mouse.x = ((e.clientX - rect.left) / container.clientWidth) * 2 - 1;
        mouse.y = -((e.clientY - rect.top) / container.clientHeight) * 2 + 1;
    }

    function handleSelection() {
        raycaster.setFromCamera(mouse, camera);
        const hits = raycaster.intersectObjects(booksContainer.children, true);

        if (hits.length > 0) {
            let obj = hits[0].object;
            while(obj.parent && !obj.userData.data) obj = obj.parent;
            if (obj.userData.data) toggleVaultNode(obj);
        }
    }

    function toggleVaultNode(group) {
        if (selectedGroup === group) {
            resetVault();
            return;
        }
        resetVault();

        selectedGroup = group;
        group.userData.active = true;
        updateHUD(group.userData.data, true);

        // Move to focus (relativo al contenedor rotado)
        const worldPos = new THREE.Vector3();
        group.getWorldPosition(worldPos);

        new TWEEN.Tween(camera.position)
            .to({ x: worldPos.x * 1.5, y: 2, z: worldPos.z * 1.5 }, 1200)
            .easing(TWEEN.Easing.Exponential.Out)
            .start();

        new TWEEN.Tween(group.position)
            .to({ y: 1 }, 1000)
            .easing(TWEEN.Easing.Elastic.Out)
            .start();

        new TWEEN.Tween(group.userData.light)
            .to({ intensity: 30 }, 500)
            .start();
        
        books.forEach(b => {
            if (b !== group) {
                new TWEEN.Tween(b.position).to({ y: -10 }, 800).easing(TWEEN.Easing.Cubic.In).start();
            }
        });
    }

    function resetVault() {
        if (!selectedGroup) return;
        updateHUD(null, false);

        new TWEEN.Tween(camera.position)
            .to({ x: 0, y: 1, z: 12 }, 1000)
            .easing(TWEEN.Easing.Cubic.InOut)
            .start();

        new TWEEN.Tween(selectedGroup.position)
            .to({ y: 0 }, 800)
            .easing(TWEEN.Easing.Quadratic.Out)
            .start();

        new TWEEN.Tween(selectedGroup.userData.light)
            .to({ intensity: 0 }, 400)
            .start();

        books.forEach(b => {
            new TWEEN.Tween(b.position).to({ y: 0 }, 1000).easing(TWEEN.Easing.Cubic.Out).start();
            b.userData.active = false;
        });

        selectedGroup = null;
    }

    function updateHUD(data, active) {
        const panel = document.getElementById('book-data-panel');
        const title = document.getElementById('book-title');
        const author = document.getElementById('book-author');
        const year = document.getElementById('book-year');
        const genre = document.getElementById('book-genre');
        const index = document.getElementById('book-index');
        const line = document.getElementById('author-line');

        if (active && data) {
            title.textContent = data.title;
            author.textContent = data.author;
            year.textContent = data.year;
            genre.textContent = data.genre;
            index.textContent = data.id.replace('-', '.');

            panel.style.opacity = '1';
            panel.style.transform = 'translateY(0)';
            line.style.width = '100px';
        } else {
            panel.style.opacity = '0';
            panel.style.transform = 'translateY(20px)';
            line.style.width = '0';
        }
    }

    function onWindowResize() {
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
    }

    function animate() {
        requestAnimationFrame(animate);
        TWEEN.update();
        const t = clock.getElapsedTime();

        // Kinetic Rotation Logic
        if (!isDragging && !selectedGroup) {
            rotationVelocity += 0.0002; // Slow auto-drift
            targetRotation += rotationVelocity;
            rotationVelocity *= friction;
        }

        currentRotation += (targetRotation - currentRotation) * 0.1;
        booksContainer.rotation.y = currentRotation;

        // HUD Rotation Feedback
        const progress = ((currentRotation % (Math.PI * 2)) / (Math.PI * 2)) * 100;
        const bar = document.getElementById('rotation-progress');
        if (bar) bar.style.width = `${Math.abs(progress)}%`;

        // Particles & Grid
        if (particles) particles.rotation.y = t * 0.05;
        if (gridHelper) gridHelper.position.z = (t * 2) % 1;
        if (vaultRing) vaultRing.rotation.z = -t * 0.1;

        // Floating Motion
        books.forEach((b, i) => {
            if (!b.userData.active) {
                b.position.y = Math.sin(t + i) * 0.1;
            }
        });

        // Parallax Camera (solo si no hay selección)
        if (!selectedGroup) {
            camera.position.x += (mouse.x * 1.5 - camera.position.x) * 0.05;
            camera.position.y += (-mouse.y * 1.5 + 1 - camera.position.y) * 0.05;
            camera.lookAt(0, 0, 0);
        }

        renderer.render(scene, camera);
    }

    document.addEventListener('astro:page-load', () => {
        if (!window.vaultActive) {
            init();
            window.vaultActive = true;
        }
    });

    if (!window.vaultActive) {
        init();
        window.vaultActive = true;
    }
</script>

<style>
    @font-face {
        font-family: 'AstroHUD';
        src: local('Inter Black'), local('Roboto Black');
    }

    #library-vault {
        font-family: 'Inter', sans-serif;
    }

    .hud-overlay {
        background: radial-gradient(circle at center, transparent 30%, rgba(0,0,0,0.6) 100%);
    }

    #book-title {
        text-shadow: 0 0 20px rgba(255,255,255,0.2), 0 0 40px rgba(59, 130, 246, 0.4);
        font-family: 'AstroHUD', sans-serif;
    }

    #book-index {
        text-shadow: 0 0 10px rgba(59, 130, 246, 0.8);
    }
</style>
