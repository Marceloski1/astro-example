---
const { books } = Astro.props;
---

<div class="relative w-full max-w-xl mx-auto mb-12">
  <div class="relative">
    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
      <svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
      </svg>
    </div>
    <input
      type="text"
      id="local-search"
      class="block w-full pl-10 pr-3 py-3 border border-gray-800 rounded-2xl bg-gray-900/50 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all backdrop-blur-sm"
      placeholder="Buscar por título, autor o descripción..."
    />
  </div>
</div>

<script is:inline define:vars={{ books }}>
  document.addEventListener('astro:page-load', () => {
    const searchInput = document.getElementById('local-search');
    const articles = document.querySelectorAll('article');

    searchInput?.addEventListener('input', (e) => {
      const term = e.target.value.toLowerCase();
      
      articles.forEach(article => {
        const title = article.querySelector('h2')?.textContent?.toLowerCase() || '';
        const desc = article.querySelector('p')?.textContent?.toLowerCase() || '';
        
        if (title.includes(term) || desc.includes(term)) {
          article.style.display = 'flex';
          article.classList.add('animate-fade-in');
        } else {
          article.style.display = 'none';
        }
      });

      const container = document.querySelector('.grid');
      const noResults = document.getElementById('no-results');
      
      const visibleArticles = Array.from(articles).filter(a => a.style.display !== 'none');
      
      if (visibleArticles.length === 0) {
        if (!noResults) {
          const msg = document.createElement('div');
          msg.id = 'no-results';
          msg.className = 'col-span-full text-center py-20 animate-fade-in';
          msg.innerHTML = '<p class="text-gray-500 text-xl">No se encontraron libros que coincidan con tu búsqueda.</p>';
          container?.appendChild(msg);
        }
      } else {
        noResults?.remove();
      }
    });
  });
</script>
