---
---

<div id="tunnel-stage" class="w-full h-[500vh] relative bg-black overflow-hidden">
    <!-- Overlay UI (Premium HUD) -->
    <div class="fixed inset-0 pointer-events-none z-10 p-12 flex flex-col justify-between" id="tunnel-hud">
        <div class="flex justify-between items-start">
            <div class="flex flex-col gap-3">
                <div class="flex items-center gap-3">
                    <div class="w-2 h-2 rounded-full bg-blue-500 animate-pulse shadow-[0_0_10px_rgba(59,130,246,1)]"></div>
                    <span class="text-[0.6rem] font-mono text-white/50 uppercase tracking-[0.5em]">Tachyonic.Drive.Active</span>
                </div>
                <div class="h-[1px] w-80 bg-white/5 relative overflow-hidden">
                    <div id="velocity-bar" class="absolute inset-y-0 left-0 w-0 bg-gradient-to-r from-blue-600 to-cyan-400 shadow-[0_0_15px_rgba(59,130,246,0.5)] transition-all duration-300"></div>
                </div>
            </div>
            <div class="text-right font-mono">
                <div class="text-[0.5rem] text-white/20 uppercase tracking-widest mb-1">Compression Ratio: 1.08:1</div>
                <div id="depth-tag" class="text-white text-3xl font-black italic tracking-tighter tabular-nums">000,000 LY</div>
            </div>
        </div>

        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex flex-col items-center gap-4 text-center group cursor-none" id="warp-core-hint">
            <div class="w-32 h-32 rounded-full border border-white/5 flex items-center justify-center relative">
                <div class="absolute inset-0 rounded-full border border-blue-500/20 animate-ping"></div>
                <div class="w-1 h-1 bg-white rounded-full shadow-[0_0_20px_white]"></div>
            </div>
            <div class="text-[0.5rem] text-white/40 uppercase tracking-[1em] translate-y-4">Scroll to Accelerate</div>
        </div>

        <div class="flex justify-between items-end">
            <div class="flex flex-col gap-1 max-w-xs">
                <span class="text-[0.4rem] text-blue-400/50 uppercase tracking-[0.2em] font-mono">Warning: Space-Time Distortion detected</span>
                <p class="text-[0.5rem] text-white/10 uppercase tracking-widest leading-relaxed">
                    Internal System Check: Optical Flow OK<br/>
                    Structure Integrity: 88.4%
                </p>
            </div>
            <div class="text-right">
                 <div class="flex items-center gap-4 opacity-30">
                    <span class="text-[0.5rem] text-white uppercase tracking-widest">Warp Factor</span>
                    <span id="warp-val" class="text-xl font-mono text-blue-500 italic">0.0</span>
                 </div>
            </div>
        </div>
    </div>

    <!-- Background Vignette for Depth -->
    <div class="fixed inset-0 pointer-events-none ring-[150px] ring-inset ring-black z-0"></div>
    
    <!-- Heavy Canvas Glow -->
    <div class="fixed inset-0 pointer-events-none bg-radial-gradient from-blue-900/10 via-transparent to-transparent z-0 opacity-50" id="canvas-glow"></div>

    <div class="fixed inset-0" id="tunnel-canvas-container"></div>
</div>

<script>
    import * as THREE from 'three';

    let scene, camera, renderer, clock;
    let tunnelGroup, starfield, pipeSystem = [];
    let scrollPos = 0;
    let targetScroll = 0;
    let currentSpeed = 0.05;
    
    const container = document.getElementById('tunnel-canvas-container');

    function init() {
        if (!container) return;

        scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x000000, 0.03);

        camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 10;

        renderer = new THREE.WebGLRenderer({ 
            antialias: true, 
            alpha: true,
            powerPreference: "high-performance"
        });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        container.appendChild(renderer.domElement);

        clock = new THREE.Clock();

        // 1. High-Density Starfield
        const starGeo = new THREE.BufferGeometry();
        const starCount = 3000;
        const starPos = new Float32Array(starCount * 3);
        const starSize = new Float32Array(starCount);
        
        for(let i=0; i<starCount; i++) {
            starPos[i*3] = (Math.random() - 0.5) * 200;
            starPos[i*3+1] = (Math.random() - 0.5) * 200;
            starPos[i*3+2] = (Math.random() - 1) * 800;
            starSize[i] = Math.random();
        }
        
        starGeo.setAttribute('position', new THREE.BufferAttribute(starPos, 3));
        starGeo.setAttribute('size', new THREE.BufferAttribute(starSize, 1));
        
        const starMat = new THREE.PointsMaterial({ 
            color: 0xffffff, 
            size: 0.1, 
            transparent: true, 
            opacity: 0.8,
            blending: THREE.AdditiveBlending 
        });
        starfield = new THREE.Points(starGeo, starMat);
        scene.add(starfield);

        // 2. Realistic Tunnel Pipes (Neon Ribs)
        tunnelGroup = new THREE.Group();
        scene.add(tunnelGroup);

        const tubeRadius = 12;
        for (let i = 0; i < 60; i++) {
            const z = -i * 15;
            const geo = new THREE.TorusGeometry(tubeRadius, 0.03, 8, 100);
            const mat = new THREE.MeshStandardMaterial({
                color: 0x000000,
                emissive: i % 2 === 0 ? 0x0088ff : 0x00ffff,
                emissiveIntensity: 5,
                metalness: 1,
                roughness: 0
            });
            const ring = new THREE.Mesh(geo, mat);
            ring.position.z = z;
            ring.rotation.z = Math.random() * Math.PI;
            tunnelGroup.add(ring);
            pipeSystem.push(ring);
            
            // Random floating "power lines"
            if (i % 5 === 0) {
                const lineGeo = new THREE.CylinderGeometry(0.01, 0.01, 30);
                const line = new THREE.Mesh(lineGeo, mat);
                const angle = Math.random() * Math.PI * 2;
                line.position.set(Math.cos(angle) * tubeRadius, Math.sin(angle) * tubeRadius, z + 7.5);
                line.rotation.x = Math.PI / 2;
                tunnelGroup.add(line);
                pipeSystem.push(line);
            }
        }

        // Lighting for pipes
        const pLight = new THREE.PointLight(0x0088ff, 100, 100);
        scene.add(pLight);

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onResize);

        animate();
    }

    function onScroll() {
        const totalH = document.documentElement.scrollHeight - window.innerHeight;
        targetScroll = window.scrollY / totalH;
    }

    function onResize() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    }

    function animate() {
        requestAnimationFrame(animate);
        const dt = clock.getDelta();
        const t = clock.getElapsedTime();

        // Smooth Scroll Interpolation
        scrollPos += (targetScroll - scrollPos) * 0.1;
        
        // Acceleration Physics (Tuned for smoother control)
        const warpSpeed = 0.1 + scrollPos * 4.5;
        currentSpeed += (warpSpeed - currentSpeed) * 0.03;

        // Space-Time Warping (Tuned FOV Stretch)
        camera.fov = 60 + (currentSpeed * 1.5);
        camera.updateProjectionMatrix();

        // Starfield Movement
        starfield.position.z += currentSpeed * 2;
        if (starfield.position.z > 200) starfield.position.z = 0;

        // Tunnel Movement & Looping
        tunnelGroup.position.z += currentSpeed;
        if (tunnelGroup.position.z > 15) tunnelGroup.position.z -= 15;

        // Cinematic Camera Dynamics
        camera.position.x = Math.sin(t * 0.5) * 0.2;
        camera.position.y = Math.cos(t * 0.3) * 0.2;
        camera.rotation.z = Math.sin(t * 0.2) * 0.05 + (scrollPos * 0.2);

        // Turbulence (Shake)
        if (scrollPos > 0.5) {
            const shake = (scrollPos - 0.5) * 0.1;
            camera.position.x += (Math.random() - 0.5) * shake;
            camera.position.y += (Math.random() - 0.5) * shake;
        }

        // HUD Synchronicity
        updateHUD();

        renderer.render(scene, camera);
    }

    function updateHUD() {
        const bar = document.getElementById('velocity-bar');
        const tag = document.getElementById('depth-tag');
        const warpLabel = document.getElementById('warp-val');
        const core = document.getElementById('warp-core-hint');
        const glow = document.getElementById('canvas-glow');

        if (bar) bar.style.width = `${scrollPos * 100}%`;
        if (tag) tag.textContent = `${Math.floor(scrollPos * 500000).toLocaleString()} LY`;
        if (warpLabel) warpLabel.textContent = (scrollPos * 9.9).toFixed(1);
        
        // Dynamic Glow Intensity
        if (glow) glow.style.opacity = (0.2 + scrollPos * 0.8).toString();
        
        // Fade hint on scroll
        if (core) core.style.opacity = Math.max(0, 1 - scrollPos * 10).toString();
    }

    document.addEventListener('astro:page-load', () => {
        if (!window.tunnelActive) {
            init();
            window.tunnelActive = true;
        }
    });

    if (!window.tunnelActive) {
        init();
        window.tunnelActive = true;
    }
</script>

<style>
    #tunnel-stage::-webkit-scrollbar { display: none; }
    #tunnel-stage { scrollbar-width: none; }

    /* Performance optimization: Hardware acceleration for HUD */
    #tunnel-hud {
        will-change: transform, opacity;
        backface-visibility: hidden;
    }

    #depth-tag {
        text-shadow: 0 0 20px rgba(255,255,255,0.3);
    }
</style>
