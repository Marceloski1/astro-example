<div id="morph-stage" class="w-full h-screen relative bg-black overflow-hidden flex items-center justify-center">
    <!-- UI Overlay -->
    <div class="absolute inset-0 z-10 pointer-events-none p-12 flex flex-col justify-between items-center">
        <h1 class="text-white font-mono text-[0.6rem] tracking-[1em] uppercase opacity-40">Morphing.State: <span id="morph-label" class="text-blue-500">SPHERE</span></h1>
        
        <div class="flex gap-4 mb-20 pointer-events-auto">
            <button onclick="window.morphTo('sphere')" class="px-6 py-2 border border-white/10 rounded-full text-[0.5rem] font-mono hover:bg-white/5 text-white transition-all uppercase tracking-widest">Sphere</button>
            <button onclick="window.morphTo('box')" class="px-6 py-2 border border-white/10 rounded-full text-[0.5rem] font-mono hover:bg-white/5 text-white transition-all uppercase tracking-widest">Cube</button>
            <button onclick="window.morphTo('torus')" class="px-6 py-2 border border-white/10 rounded-full text-[0.5rem] font-mono hover:bg-white/5 text-white transition-all uppercase tracking-widest">Torus</button>
        </div>
    </div>

    <div class="absolute inset-0" id="morph-canvas-container"></div>
</div>

<script>
    import * as THREE from 'three';

    let scene, camera, renderer, particles;
    let counts = 5000;
    
    let targetPositions = [];
    let startPositions = [];
    let animationProgress = 1; // 1 means animation finished
    let startTime = 0;
    const duration = 1500; // ms

    const container = document.getElementById('morph-canvas-container');

    function getPoints(geo) {
        const pts = [];
        const position = geo.attributes.position;
        for(let i=0; i<counts; i++) {
            const index = Math.floor(Math.random() * position.count);
            pts.push(
                position.getX(index),
                position.getY(index),
                position.getZ(index)
            );
        }
        return pts;
    }

    function init() {
        if (!container) return;

        scene = new THREE.Scene();
        camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 5;

        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        container.appendChild(renderer.domElement);

        const sphereGeo = new THREE.SphereGeometry(2, 64, 64);
        const initialPts = getPoints(sphereGeo);
        startPositions = [...initialPts];
        targetPositions = [...initialPts];

        const geo = new THREE.BufferGeometry();
        geo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(initialPts), 3));
        
        const mat = new THREE.PointsMaterial({ size: 0.02, color: 0x3b82f6, transparent: true, opacity: 0.8, blending: THREE.AdditiveBlending });
        particles = new THREE.Points(geo, mat);
        scene.add(particles);

        window.morphTo = (type) => {
            let targetGeo;
            const label = document.getElementById('morph-label');
            if (label) label.textContent = type.toUpperCase();

            if (type === 'sphere') targetGeo = new THREE.SphereGeometry(2, 64, 64);
            if (type === 'box') targetGeo = new THREE.BoxGeometry(3, 3, 3, 30, 30, 30);
            if (type === 'torus') targetGeo = new THREE.TorusGeometry(2, 0.8, 40, 100);

            startPositions = [...particles.geometry.attributes.position.array];
            targetPositions = getPoints(targetGeo);
            animationProgress = 0;
            startTime = performance.now();
        };

        window.addEventListener('resize', onResize);
        animate();
    }

    function onResize() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    }

    function animate() {
        requestAnimationFrame(animate);

        if (animationProgress < 1) {
            const now = performance.now();
            animationProgress = Math.min(1, (now - startTime) / duration);
            
            // Ease in out quartic
            const t = animationProgress < 0.5 
                ? 8 * animationProgress * animationProgress * animationProgress * animationProgress 
                : 1 - Math.pow(-2 * animationProgress + 2, 4) / 2;

            const pos = particles.geometry.attributes.position.array;
            for (let i = 0; i < counts * 3; i++) {
                pos[i] = startPositions[i] + (targetPositions[i] - startPositions[i]) * t;
            }
            particles.geometry.attributes.position.needsUpdate = true;
        }

        particles.rotation.y += 0.005;
        renderer.render(scene, camera);
    }

    document.addEventListener('astro:page-load', () => {
        const container = document.getElementById('morph-canvas-container');
        if (container && container.children.length === 0) init();
    });

    init();
</script>
