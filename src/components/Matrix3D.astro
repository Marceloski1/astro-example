<div id="matrix-stage" class="w-full h-screen relative bg-black overflow-hidden">
    <!-- UI Overlay -->
    <div class="absolute inset-0 z-10 pointer-events-none p-12 flex flex-col justify-between">
        <div class="flex justify-between items-start">
            <span class="text-green-500 font-mono text-xs tracking-widest animate-pulse">SYSTEM.OVERRIDE.ACTIVE</span>
            <div class="text-right text-white/20 font-mono text-[0.5rem] uppercase">Buffer Overload: 44.1%</div>
        </div>
        
        <div class="text-center">
            <h1 class="text-8xl font-black text-green-500/10 italic select-none">DATA RAIN</h1>
            <p class="text-green-500 font-mono text-[0.6rem] tracking-[0.5em] uppercase mt-4">Decoding Library Core...</p>
        </div>

        <div class="flex justify-between items-end border-t border-green-500/10 pt-4">
            <span class="text-[0.4rem] text-green-500/30 uppercase tracking-widest">Sector_Grid_09</span>
            <span class="text-[0.4rem] text-green-500/30 uppercase tracking-widest">Latency: 2ms</span>
        </div>
    </div>

    <div class="absolute inset-0" id="matrix-canvas-container"></div>
</div>

<script>
    import * as THREE from 'three';

    let scene, camera, renderer, clock;
    let instancedMesh;
    const count = 2000;
    const characters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789$+-*/=%\"'#&_(),.;:?!\\|{}<>[]^~".split("");

    const container = document.getElementById('matrix-canvas-container');

    function init() {
        if (!container) return;

        scene = new THREE.Scene();
        camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 20;

        renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        container.appendChild(renderer.domElement);

        clock = new THREE.Clock();

        // Create Text Geometry via Instancing
        const geo = new THREE.PlaneGeometry(0.3, 0.5);
        const mat = new THREE.MeshBasicMaterial({ 
            color: 0x00ff41, 
            transparent: true, 
            opacity: 0.8,
            side: THREE.DoubleSide
        });

        instancedMesh = new THREE.InstancedMesh(geo, mat, count);
        scene.add(instancedMesh);

        const dummy = new THREE.Object3D();
        for(let i=0; i<count; i++) {
            dummy.position.set(
                (Math.random() - 0.5) * 60,
                (Math.random() - 0.5) * 60,
                (Math.random() - 0.5) * 100
            );
            dummy.updateMatrix();
            instancedMesh.setMatrixAt(i, dummy.matrix);
        }

        window.addEventListener('resize', onResize);
        animate();
    }

    function onResize() {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    }

    function animate() {
        requestAnimationFrame(animate);
        const t = clock.getElapsedTime();
        const dummy = new THREE.Object3D();
        const matrix = new THREE.Matrix4();

        for(let i=0; i<count; i++) {
            instancedMesh.getMatrixAt(i, matrix);
            dummy.setRotationFromMatrix(matrix);
            dummy.position.setFromMatrixPosition(matrix);

            // Move Down
            dummy.position.y -= 0.2 + (i % 5) * 0.1;
            if (dummy.position.y < -30) dummy.position.y = 30;

            // Twinkle through color
            const intensity = 0.5 + Math.sin(t * 5 + i) * 0.5;
            const color = new THREE.Color(0x00ff41).multiplyScalar(intensity);
            instancedMesh.setColorAt(i, color);

            dummy.updateMatrix();
            instancedMesh.setMatrixAt(i, dummy.matrix);
        }
        instancedMesh.instanceMatrix.needsUpdate = true;
        instancedMesh.instanceColor.needsUpdate = true;

        renderer.render(scene, camera);
    }

    document.addEventListener('astro:page-load', () => {
        const container = document.getElementById('matrix-canvas-container');
        if (container && container.children.length === 0) init();
    });

    init();
</script>
